{
    // ================= 你的保留配置 =================
    "editor.mouseWheelZoom": true,
    "workbench.iconTheme": "material-icon-theme",
    // ================= 平台特定路径配置 =================
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
    "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    // ================= 基础编辑器优化 =================
    "editor.fontSize": 16,
    "editor.fontFamily": "'Droid Sans Mono', 'Consolas', 'Courier New', monospace",
    "editor.formatOnSave": true,
    "editor.renderWhitespace": "selection",
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.guides.bracketPairs": true,
    "editor.bracketPairColorization.enabled": true,
    "files.autoSave": "afterDelay",
    "workbench.editor.empty.hint": "hidden",
    "editor.largeFileOptimizations": false,
    // ================= Vim/Neovim 行为适配 (绝对优先) =================
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    // Insert 模式下放行部分键位，以便使用终端习惯 (如 Ctrl+W 删词, Ctrl+H 退格)
    "vscode-neovim.ctrlKeysForInsertMode": [
        "a",
        "d",
        "h",
        "j",
        "k",
        "o",
        "r",
        "t",
        "w"
    ],
    // Normal 模式下实施全面接管
    "vscode-neovim.ctrlKeysForNormalMode": [
        "a",
        "b",
        "c",
        "d",
        "e",
        "f",
        "h",
        "i",
        "j",
        "k",
        "l",
        "m",
        "o",
        "r",
        "t",
        "u",
        "v",
        "w",
        "x",
        "y",
        "z",
        "/",
        "]"
    ],
    // ================= Verilog 环境配置 =================
    "verilog.linting.linter": "verilator",
    "verilog.linting.verilator.arguments": "-sv -Wall --lint-only",
    "verilog.linting.verilator.runAtFileLocation": true,
    "[verilog]": {
        "editor.defaultFormatter": "teros-technology.teroshdl",
        "editor.formatOnSave": false
    },
    "[systemverilog]": {
        "editor.defaultFormatter": "teros-technology.teroshdl",
        "editor.formatOnSave": false
    },
    "teroshdl.formatter.provider": "istyle",
    "teroshdl.formatter.style": "kr",
    // ================= 解决 Windows/Linux 同步冲突 =================
    "settingsSync.ignoredSettings": [
        "verilog.linting.linter"
    ],
    "settingsSync.ignoredExtensions": [],
    // ================= C/C++ 开发环境 =================
    "makefile.configureOnOpen": true,
    "C_Cpp.default.configurationProvider": "ms-vscode.makefile-tools",
    // ================= Python / 终端 / 杂项 =================
    "python.terminal.activateEnvironment": true,
    "python.analysis.typeCheckingMode": "basic",
    "commentTranslate.targetLanguage": "zh-CN",
    "commentTranslate.hover.concise": true,
    "terminal.integrated.sendKeybindingsToShell": true,
    "terminal.integrated.inheritEnv": false,
    "diffEditor.maxComputationTime": 0,
    "claudeCode.preferredLocation": "panel",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{hexdiff}:/**/*.*": "hexEditor.hexedit",
        "*.vcd": "surfer.waveformViewer"
    },
    "claude-history.database.storeMessages": false,
    "workbench.browser.showInTitleBar": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chatgpt.runCodexInWindowsSubsystemForLinux": false,
    "chatgpt.reviewDelivery": "inline",
    "chatgpt.followUpQueueMode": "queue"
}
